DATABASE_URL="postgresql://beauty:beauty@localhost:5432/beauty?schema=public"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-at-least-32-character-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
CORS_ORIGINS="http://localhost:3000"
PORT=3001
NODE_ENV=development
TRUST_PROXY=false
EXTERNAL_REQUEST_TIMEOUT_MS=10000
RETRY_MAX_ATTEMPTS=3
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_WINDOW_MS=60000
AI_TRACE_RETENTION_DAYS=30
AI_MAX_ESTIMATED_COST_MICROS=100000
AI_RATE_LIMIT_PER_MINUTE=20
# Generate with: openssl rand -base64 32
PUSH_TOKEN_ENCRYPTION_KEY=

# 32-byte base64 key used to encrypt webhook signing secrets at rest
WEBHOOK_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Stage 33 rollout: private MVP endpoints and worker stay closed by default.
STAGE33_MVP_ENABLED=false
# Redis is a wakeup accelerator only. PostgreSQL retains job authority.
MVP_REDIS_ENABLED=false
# Use rediss:// with verified TLS in production. Keep secrets in runtime bindings.
MVP_REDIS_URL=

# Stage 33 private-photo/AI rollout. Leave closed until the reviewed policy and runtime bindings exist.
MVP_PHOTO_POLICY_REVIEWED=false
MVP_PHOTO_POLICY_VERSION=
MVP_PHOTO_NOTICE=
MVP_PHOTO_RETENTION_HOURS=
MVP_PHOTO_AUDIT_RETENTION_DAYS=
MVP_S3_ENABLED=false
MVP_S3_BUCKET=
AWS_REGION=
# Use the runtime's IAM role/secret binding; never put real AWS credentials in this file.
MVP_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MVP_AI_DAILY_REQUEST_LIMIT=
MVP_AI_GLOBAL_DAILY_REQUEST_LIMIT=
MVP_SEMANTIC_ENABLED=false
MVP_VERIFICATION_POLICY_REVIEWED=false
MVP_VERIFICATION_POLICY_VERSION=
MVP_VERIFICATION_NOTICE=
MVP_VERIFICATION_FIELDS_JSON=
MVP_VERIFICATION_RETENTION_DAYS=

# Operator-only account deletion freeze boundary; not an erasure worker.
ACCOUNT_DELETION_PROCESSING_ENABLED=false

# Explicit operator finalization; unreviewed domain data blocks erasure.
ACCOUNT_DELETION_ERASURE_ENABLED=false
