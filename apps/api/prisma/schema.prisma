  id            String                  @id @default(cuid())
  endpointId    String
  eventId       String                  @unique
  eventType     String
  eventVersion  Int
  payload       Json
  status        WebhookDeliveryStatusV1 @default(PENDING)
  nextAttemptAt DateTime
  deliveredAt   DateTime?
  createdAt     DateTime                @default(now())
  endpoint      WebhookEndpoint         @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts      WebhookAttempt[]

  @@index([endpointId, status, nextAttemptAt])
}

model WebhookAttempt {
  id            String          @id @default(cuid())
  deliveryId    String
  attemptNumber Int
  statusCode    Int?
  errorCode     String?
  attemptedAt   DateTime        @default(now())
  delivery      WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
}

model APIUsageRecord {
  id            String         @id @default(cuid())
  applicationId String
  clientId      String
  businessId    String
  operation     String
  statusCode    Int
  latencyMs     Int
  requestId     String
  occurredAt    DateTime       @default(now())
  application   APIApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  client        APIClient      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, occurredAt])
  @@index([clientId, operation, occurredAt])
}

model APIRateLimitBucket {
  id          String    @id @default(cuid())
  clientId    String
  businessId  String
  operation   String
  windowStart DateTime
  count       Int       @default(0)
  expiresAt   DateTime
  client      APIClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([clientId, businessId, operation, windowStart])
  @@index([expiresAt])
}

enum CategoryCapabilityKey {
  BOOKING
  AVAILABILITY
  PROFESSIONAL_MATCHING
  RESULT
  PORTFOLIO
  BEFORE_AFTER
  CONSULTATION
  PHOTO_INPUT
  AI_ANALYSIS
  PRODUCT_RECOMMENDATION
  MULTI_SESSION
  RESOURCE_REQUIRED
  ROOM_REQUIRED
  EQUIPMENT_REQUIRED
  GROUP_BOOKING
  DURATION_VARIANTS
  ADD_ON_SERVICES
  CUSTOM_ATTRIBUTES
}

enum CategoryAttributeType {
  STRING
  NUMBER
  BOOLEAN
  ENUM
  MULTI_ENUM
  DATE
  DURATION
}

model PlatformCategory {
  id                      String                           @id @default(cuid())
  key                     String                           @unique
  name                    String
  version                 Int                              @default(1)
  isActive                Boolean                          @default(true)
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  subcategories           PlatformSubcategory[]
  serviceTypes            PlatformServiceType[]
  capabilities            PlatformCategoryCapability[]
  attributes              CategoryAttributeDefinition[]
  resultSchemas           CategoryResultSchema[]
  tenantConfigurations    TenantCategoryConfiguration[]
  services                Service[]
  professionalAssignments ProfessionalCategoryAssignment[]
  marketAvailability      MarketCategoryAvailability[]

  @@index([isActive, name])
}

model PlatformSubcategory {
  id                   String                        @id @default(cuid())
  categoryId           String
  key                  String
  name                 String
  isActive             Boolean                       @default(true)
  category             PlatformCategory              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceTypes         PlatformServiceType[]
  services             Service[]
  tenantConfigurations TenantCategoryConfiguration[]

  @@unique([categoryId, key])
  @@index([categoryId, isActive])
}

model PlatformServiceType {
  id                      String                              @id @default(cuid())
  categoryId              String
  subcategoryId           String?
  key                     String
  name                    String
  isActive                Boolean                             @default(true)
  category                PlatformCategory                    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory             PlatformSubcategory?                @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  services                Service[]
  attributes              CategoryAttributeDefinition[]
  tenantConfigurations    TenantCategoryConfiguration[]
  professionalAssignments ProfessionalServiceTypeAssignment[]

  @@unique([categoryId, key])
  @@index([subcategoryId, isActive])
}

model PlatformCategoryCapability {
  id            String                @id @default(cuid())
  categoryId    String
  capability    CategoryCapabilityKey
  configuration Json?
  category      PlatformCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, capability])
}

model CategoryAttributeDefinition {
  id            String                    @id @default(cuid())
  categoryId    String
  serviceTypeId String?
  key           String
  label         String
  type          CategoryAttributeType
  required      Boolean                   @default(false)
  minValue      Decimal?                  @db.Decimal(16, 4)
  maxValue      Decimal?                  @db.Decimal(16, 4)
  defaultValue  Json?
  isActive      Boolean                   @default(true)
  category      PlatformCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  serviceType   PlatformServiceType?      @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  options       CategoryAttributeOption[]
  values        ServiceAttributeValue[]

  @@unique([categoryId, serviceTypeId, key])
  @@index([categoryId, serviceTypeId, isActive])
}

model CategoryAttributeOption {
  id           String                      @id @default(cuid())
  definitionId String
  value        String
  label        String
  sortOrder    Int                         @default(0)
  definition   CategoryAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, value])
}

model TenantCategoryConfiguration {
  id            String               @id @default(cuid())
  businessId    String
  categoryId    String
  subcategoryId String?
  serviceTypeId String?
  enabled       Boolean              @default(true)
  settings      Json?
  version       Int                  @default(1)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category      PlatformCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory   PlatformSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  serviceType   PlatformServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@unique([businessId, categoryId, subcategoryId, serviceTypeId])
  @@index([businessId, enabled, categoryId])
}

model ServiceAttributeValue {
  id              String                      @id @default(cuid())
  businessId      String
  serviceId       String
  definitionId    String
  stringValue     String?
  numberValue     Decimal?                    @db.Decimal(16, 4)
  booleanValue    Boolean?
  dateValue       DateTime?
  durationMinutes Int?
  enumValues      String[]
  service         Service                     @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Cascade)
  definition      CategoryAttributeDefinition @relation(fields: [definitionId], references: [id], onDelete: Restrict)

  @@unique([serviceId, definitionId])
  @@index([businessId, definitionId])
}

model PlatformResourceType {
  id           String                       @id @default(cuid())
  businessId   String
  key          String
  name         String
  business     Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resources    PlatformResource[]
  requirements ServiceResourceRequirement[]

  @@unique([businessId, key])
}

model PlatformResource {
  id             String               @id @default(cuid())
  businessId     String
  resourceTypeId String
  name           String
  capacity       Int                  @default(1)
  isActive       Boolean              @default(true)
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  resourceType   PlatformResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)

  @@unique([businessId, id])
  @@index([businessId, resourceTypeId, isActive])
}

model ServiceResourceRequirement {
  id             String               @id @default(cuid())
  businessId     String
  serviceId      String
  resourceTypeId String
  quantity       Int                  @default(1)
  service        Service              @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Cascade)
  resourceType   PlatformResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)

  @@unique([serviceId, resourceTypeId])
  @@index([businessId, resourceTypeId])
}

model ProfessionalCategoryAssignment {
  businessId String
  staffId    String
  categoryId String
  isActive   Boolean          @default(true)
  staff      Staff            @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  category   PlatformCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([staffId, categoryId])
  @@index([businessId, categoryId, isActive])
}

model ProfessionalServiceTypeAssignment {
  businessId    String
  staffId       String
  serviceTypeId String
  skills        String[]
  isActive      Boolean             @default(true)
  staff         Staff               @relation(fields: [businessId, staffId], references: [businessId, id], onDelete: Cascade)
  serviceType   PlatformServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceTypeId])
  @@index([businessId, serviceTypeId, isActive])
}

model CategoryResultSchema {
  id         String           @id @default(cuid())
  categoryId String
  version    Int
  schema     Json
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  category   PlatformCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, version])
  @@index([categoryId, isActive, version])
}

enum MarketStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum GlobalMeasurementSystem {
  METRIC
  IMPERIAL
}

model Market {
  id                   String                       @id @default(cuid())
  key                  String                       @unique
  countryCode          String                       @db.Char(2)
  regionCode           String?
  status               MarketStatus                 @default(DRAFT)
  createdAt            DateTime                     @default(now())
  configurations       MarketConfiguration[]
  tenantProfiles       TenantGlobalizationProfile[]
  categoryAvailability MarketCategoryAvailability[]
  translations         MarketTranslation[]
  fxRates              FxRateSnapshot[]
  monetizationPlans    MonetizationPlan[]
  pricingRules         FinancialPricingRule[]
  commissionRules      CommissionRule[]
  promotions           FinancialPromotion[]
  aiCostConfigurations AICostConfiguration[]

  @@index([countryCode, status])
}

model MarketConfiguration {
  id                      String                       @id @default(cuid())
  marketId                String
  version                 Int
  status                  MarketStatus                 @default(DRAFT)
  defaultLocale           String
  supportedLocales        String[]
  defaultCurrency         String                       @db.Char(3)
  supportedCurrencies     String[]
  defaultTimezone         String
  supportedTimezones      String[]
  measurementSystem       GlobalMeasurementSystem
  dateFormatPolicy        Json
  timeFormatPolicy        Json
  numberFormatPolicy      Json
  currencyDisplayPolicy   Json
  phonePolicy             Json
  addressPolicy           Json
  taxPolicyRef            String?
  paymentPolicyRef        String?
  bookingPolicyRef        String?
  bookingPolicy           Json
  featureFlags            Json
  supportedPaymentMethods String[]
  effectiveFrom           DateTime
  effectiveTo             DateTime?
  createdAt               DateTime                     @default(now())
  market                  Market                       @relation(fields: [marketId], references: [id], onDelete: Restrict)
  tenantProfiles          TenantGlobalizationProfile[]
  appointments            Appointment[]

  @@unique([marketId, version])
  @@index([marketId, status, effectiveFrom, effectiveTo])
}

model TenantGlobalizationProfile {
  id                    String                  @id @default(cuid())
  businessId            String                  @unique
  marketId              String
  marketConfigurationId String
  preferredLocale       String
  preferredCurrency     String                  @db.Char(3)
  preferredTimezone     String
  measurementSystem     GlobalMeasurementSystem
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  business              Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  market                Market                  @relation(fields: [marketId], references: [id], onDelete: Restrict)
  marketConfiguration   MarketConfiguration     @relation(fields: [marketConfigurationId], references: [id], onDelete: Restrict)

  @@index([marketId, preferredLocale, preferredCurrency])
}

model MarketTranslation {
  id             String   @id @default(cuid())
  marketId       String
  locale         String
  namespace      String
  translationKey String
  value          String
  version        Int
  createdAt      DateTime @default(now())
  market         Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, locale, namespace, translationKey, version])
  @@index([marketId, locale, namespace])
}

model CurrencyDefinition {
  code                   String  @id @db.Char(3)
  minorUnit              Int
  displayName            String
  symbol                 String?
  roundingIncrementMinor Int     @default(1)
  isActive               Boolean @default(true)
}

model FxRateSnapshot {
  id            String   @id @default(cuid())
  marketId      String
  baseCurrency  String   @db.Char(3)
  quoteCurrency String   @db.Char(3)
  rate          Decimal  @db.Decimal(24, 12)
  provider      String
  version       Int
  effectiveAt   DateTime
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  market        Market   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([marketId, baseCurrency, quoteCurrency, provider, version])
  @@index([marketId, baseCurrency, quoteCurrency, effectiveAt, expiresAt])
}

model MarketCategoryAvailability {
  id                String           @id @default(cuid())
  marketId          String
  categoryId        String
  serviceTypeId     String?
  enabled           Boolean          @default(true)
  localizedMetadata Json?
  market            Market           @relation(fields: [marketId], references: [id], onDelete: Cascade)
  category          PlatformCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([marketId, categoryId, serviceTypeId])
  @@index([marketId, enabled, categoryId])
}

enum MonetizationStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum MonetizationPricingModel {
  FIXED
  RECURRING
  USAGE
  TIERED
  PER_SEAT
  PER_LOCATION
  PER_PROFESSIONAL
  TRANSACTION
  COMMISSION
  HYBRID
}

enum MonetizationBillingInterval {
  ONE_TIME
  MONTHLY
  ANNUAL
}

enum MonetizationSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum FinancialLedgerEntryType {
  CHARGE
  COMMISSION
  PLATFORM_FEE
  REFUND
  CREDIT
  PAYOUT
  ADJUSTMENT
  REVERSAL
}

enum FinancialSettlementStatus {
  OPEN
  FINALIZED
  PAYOUT_PENDING
  PAID
  CANCELLED
}

enum FinancialPayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REVERSED
}

model MonetizationPlan {
  id        String                    @id @default(cuid())
  marketId  String
  key       String
  status    MonetizationStatus        @default(DRAFT)
  createdAt DateTime                  @default(now())
  market    Market                    @relation(fields: [marketId], references: [id], onDelete: Restrict)
  versions  MonetizationPlanVersion[]

  @@unique([marketId, key])
  @@index([marketId, status])
}

model MonetizationPlanVersion {
  id            String                     @id @default(cuid())
  planId        String
  version       Int
  name          String
  status        MonetizationStatus         @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime                   @default(now())
  plan          MonetizationPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlements  PlanEntitlement[]
  prices        MonetizationPriceVersion[]
  subscriptions MonetizationSubscription[]

  @@unique([planId, version])
  @@index([planId, status, effectiveFrom, effectiveTo])
}

model PlanEntitlement {
  id            String                  @id @default(cuid())
  planVersionId String
  key           String
  enabled       Boolean                 @default(true)
  limitValue    BigInt?
  configuration Json?
  planVersion   MonetizationPlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)

  @@unique([planVersionId, key])
}

model MonetizationPriceVersion {
  id              String                      @id @default(cuid())
  planVersionId   String
  version         Int
  model           MonetizationPricingModel
  amountMinor     BigInt
  currency        String                      @db.Char(3)
  billingInterval MonetizationBillingInterval
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  configuration   Json
  createdAt       DateTime                    @default(now())
  planVersion     MonetizationPlanVersion     @relation(fields: [planVersionId], references: [id], onDelete: Restrict)

  @@unique([planVersionId, version])
  @@index([currency, effectiveFrom, effectiveTo])
}

model BillingAccount {
  id                  String                     @id @default(cuid())
  businessId          String                     @unique
  providerCustomerRef String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Restrict)
  subscriptions       MonetizationSubscription[]

  @@index([providerCustomerRef])
}

model MonetizationSubscription {
  id                      String                         @id @default(cuid())
  businessId              String
  billingAccountId        String
  planVersionId           String
  status                  MonetizationSubscriptionStatus
  version                 Int                            @default(1)
  trialEndsAt             DateTime?
  currentPeriodStart      DateTime
  currentPeriodEnd        DateTime
  cancelAtPeriodEnd       Boolean                        @default(false)
  cancelledAt             DateTime?
  providerSubscriptionRef String?
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  business                Business                       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  billingAccount          BillingAccount                 @relation(fields: [billingAccountId], references: [id], onDelete: Restrict)
  planVersion             MonetizationPlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  changes                 SubscriptionChange[]
  items                   SubscriptionItem[]

  @@index([businessId, status])
  @@index([providerSubscriptionRef])
}

model SubscriptionItem {
  id             String                   @id @default(cuid())
  subscriptionId String
  priceVersionId String
  quantity       BigInt                   @default(1)
  createdAt      DateTime                 @default(now())
  subscription   MonetizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, priceVersionId])
}

model SubscriptionChange {
  id             String                         @id @default(cuid())
  businessId     String
  subscriptionId String
  fromStatus     MonetizationSubscriptionStatus
  toStatus       MonetizationSubscriptionStatus
  reason         String
  actorId        String
  createdAt      DateTime                       @default(now())
  subscription   MonetizationSubscription       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([businessId, subscriptionId, createdAt])
}

model MonetizationUsageMeter {
  id          String                    @id @default(cuid())
  metric      String                    @unique
  unit        String
  aggregation String
  status      MonetizationStatus        @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  records     MonetizationUsageRecord[]
}

model MonetizationUsageRecord {
  id             String                  @id @default(cuid())
  businessId     String
  marketId       String
  meterId        String?
  metric         String
  quantity       BigInt
  source         String
  idempotencyKey String
  occurredAt     DateTime
  correlationId  String?
  createdAt      DateTime                @default(now())
  business       Business                @relation(fields: [businessId], references: [id], onDelete: Restrict)
  meter          MonetizationUsageMeter? @relation(fields: [meterId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, metric, occurredAt])
  @@index([marketId, metric, occurredAt])
}

model FinancialPricingRule {
  id            String                   @id @default(cuid())
  marketId      String
  key           String
  version       Int
  model         MonetizationPricingModel
  configuration Json
  currency      String                   @db.Char(3)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        MonetizationStatus       @default(DRAFT)
  market        Market                   @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([marketId, key, version])
  @@index([marketId, status, effectiveFrom, effectiveTo])
}

model CommissionRule {
  id                    String             @id @default(cuid())
  marketId              String
  merchantBusinessId    String?
  categoryId            String?
  campaignId            String?
  version               Int
  fixedMinor            BigInt             @default(0)
  percentageBasisPoints Int
  minimumMinor          BigInt?
  maximumMinor          BigInt?
  currency              String             @db.Char(3)
  effectiveFrom         DateTime
  effectiveTo           DateTime?
  status                MonetizationStatus @default(DRAFT)
  market                Market             @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@index([marketId, merchantBusinessId, categoryId, status, effectiveFrom])
}

model FinancialPromotion {
  id            String                @id @default(cuid())
  marketId      String
  code          String
  version       Int
  type          String
  value         BigInt
  currency      String?
  configuration Json
  validFrom     DateTime
  validTo       DateTime
  status        MonetizationStatus    @default(DRAFT)
  market        Market                @relation(fields: [marketId], references: [id], onDelete: Restrict)
  redemptions   PromotionRedemption[]

  @@unique([marketId, code, version])
  @@index([marketId, status, validFrom, validTo])
}

model PromotionRedemption {
  id             String             @id @default(cuid())
  promotionId    String
  businessId     String
  userId         String?
  amountMinor    BigInt
  currency       String             @db.Char(3)
  idempotencyKey String
  createdAt      DateTime           @default(now())
  promotion      FinancialPromotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([promotionId, userId, createdAt])
}

model FinancialLedgerEntry {
  id             String                   @id @default(cuid())
  businessId     String
  type           FinancialLedgerEntryType
  amountMinor    BigInt
  currency       String                   @db.Char(3)
  revenueStream  String?
  sourceType     String
  sourceId       String
  idempotencyKey String
  reason         String
  actorId        String?
  correlationId  String?
  reversalOfId   String?
  createdAt      DateTime                 @default(now())
  business       Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  reversalOf     FinancialLedgerEntry?    @relation("LedgerReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals      FinancialLedgerEntry[]   @relation("LedgerReversal")
  refunds        RefundRecord[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, type, createdAt])
  @@index([sourceType, sourceId])
}

model RefundRecord {
  id              String               @id @default(cuid())
  businessId      String
  originalEntryId String
  ledgerEntryId   String               @unique
  amountMinor     BigInt
  currency        String               @db.Char(3)
  idempotencyKey  String
  reason          String
  actorId         String
  createdAt       DateTime             @default(now())
  business        Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  originalEntry   FinancialLedgerEntry @relation(fields: [originalEntryId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, originalEntryId])
}

model FinancialCreditGrant {
  id             String                       @id @default(cuid())
  businessId     String
  userId         String?
  amountMinor    BigInt
  currency       String                       @db.Char(3)
  sourceType     String
  sourceId       String
  expiresAt      DateTime?
  idempotencyKey String
  createdAt      DateTime                     @default(now())
  business       Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  consumptions   FinancialCreditConsumption[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, userId, currency, expiresAt])
}

model FinancialCreditConsumption {
  id             String               @id @default(cuid())
  grantId        String
  amountMinor    BigInt
  ledgerEntryId  String               @unique
  idempotencyKey String
  createdAt      DateTime             @default(now())
  grant          FinancialCreditGrant @relation(fields: [grantId], references: [id], onDelete: Restrict)

  @@unique([grantId, idempotencyKey])
}

model FinancialSettlement {
  id              String                    @id @default(cuid())
  businessId      String
  periodStart     DateTime
  periodEnd       DateTime
  currency        String                    @db.Char(3)
  grossMinor      BigInt
  commissionMinor BigInt
  feeMinor        BigInt
  refundMinor     BigInt
  adjustmentMinor BigInt
  netPayableMinor BigInt
  status          FinancialSettlementStatus @default(OPEN)
  idempotencyKey  String
  createdAt       DateTime                  @default(now())
  finalizedAt     DateTime?
  business        Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payouts         FinancialPayout[]

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status, periodStart, periodEnd])
}

model FinancialPayout {
  id                String                @id @default(cuid())
  businessId        String
  settlementId      String
  amountMinor       BigInt
  currency          String                @db.Char(3)
  status            FinancialPayoutStatus @default(PENDING)
  providerPayoutRef String?
  idempotencyKey    String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  business          Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  settlement        FinancialSettlement   @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([businessId, idempotencyKey])
  @@unique([settlementId])
