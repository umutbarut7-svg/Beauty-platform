generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  BUSINESS_OWNER
  BUSINESS_ADMIN
  STAFF
  CUSTOMER
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BusinessRole {
  BUSINESS_OWNER
  BUSINESS_ADMIN
  MANAGER
  STAFF
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum StaffTimeOffType {
  BREAK
  TIME_OFF
  BLOCKED
  OTHER
}

enum CustomerGender {
  FEMALE
  MALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum CustomerSegmentType {
  MANUAL
  DYNAMIC
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationExecutionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  SKIPPED
}

enum NotificationTemplateStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum NotificationKind {
  TRANSACTIONAL
  MARKETING
}

enum NotificationCategory {
  BOOKING
  BOOKING_REMINDER
  BOOKING_CHANGE
  DEMAND
  BEAUTY_JOB
  RESULT
  PAYMENT
  SECURITY
  SYSTEM
  MARKETING
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum CommunicationOutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum AgentType {
  BOOKING
  CUSTOMER_BEAUTY
  BUSINESS_GROWTH
  PROFESSIONAL_COPILOT
}

enum AgentInputSource {
  TEXT
  VOICE
  PHOTO
}

enum AgentSessionStatus {
  ACTIVE
  NEEDS_INFORMATION
  NEEDS_CONFIRMATION
  EXECUTING
  COMPLETED
  FAILED
  CANCELLED
  NO_MATCH
}

enum AgentConfirmationStatus {
  PENDING
  CONFIRMED
  REJECTED
  EXPIRED
  EXECUTED
}

enum AIRunStatus {
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  NEEDS_INFORMATION
  NO_MATCH
  NOT_AVAILABLE
}

enum AISafetySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AIKillSwitchScope {
  GLOBAL
  TENANT
  AGENT_TYPE
  TOOL
}

enum PredictionStatus {
  ACTIVE
  EXPIRED
  SUPERSEDED
  INSUFFICIENT_EVIDENCE
}

enum PredictionConfidenceBand {
  LOW
  MEDIUM
  HIGH
}

enum PredictionFeedbackKind {
  ACCEPTED
  IGNORED
  REJECTED
  CONVERTED
  FALSE_POSITIVE
  FALSE_NEGATIVE
}

enum BeautyDNAStatus {
  ACTIVE
  ARCHIVED
  RECALCULATING
}

enum BeautyDNASourceType {
  DECLARED
  OBSERVED
  DERIVED
  INFERRED
}

enum BeautyDNATraitStatus {
  ACTIVE
  INACTIVE
  STALE
}

enum ProfessionalIntelligenceStatus {
  ACTIVE
  ARCHIVED
}

enum ProfessionalSourceType {
  DECLARED
  OBSERVED
  DERIVED
  INFERRED
  VERIFIED
}

enum ProfessionalRecordStatus {
  ACTIVE
  INACTIVE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum BusinessMetricSource {
  OBSERVED
  DERIVED
  INFERRED
  BENCHMARKED
  EXPERIMENTAL
}

enum BusinessTimeWindow {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ROLLING_7_DAYS
  ROLLING_30_DAYS
  ROLLING_90_DAYS
}

enum GrowthExperimentStatus {
  DRAFT
  APPROVED
  RUNNING
  COMPLETED
  CANCELLED
}

enum GrowthExperimentOutcome {
  POSITIVE
  NEGATIVE
  INCONCLUSIVE
  INSUFFICIENT_DATA
}

enum GrowthActionClass {
  READ_ONLY
  LOW_RISK_WRITE
  REQUIRES_CONFIRMATION
  PROHIBITED_AUTONOMOUS
}

model User {
  id                           String                     @id @default(cuid())
  email                        String                     @unique
  passwordHash                 String
  role                         UserRole                   @default(CUSTOMER)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  memberships                  BusinessMember[]
  sessions                     RefreshSession[]
  customer                     Customer?
  authoredCustomerNotes        CustomerNote[]
  staffProfiles                Staff[]
  cancelledAppointments        Appointment[]              @relation("AppointmentCancelledBy")
  appointmentStatusChanges     AppointmentStatusHistory[]
  createdStaffTimeOff          StaffTimeOff[]
  apiApplications              APIApplication[]
  createdAutomations           Automation[]
  createdNotificationTemplates NotificationTemplate[]
  notifications                Notification[]
  notificationPreferences      NotificationPreference[]
  pushDevices                  PushDevice[]
  conversationParticipants     ConversationParticipant[]
  sentMessages                 Message[]
  messageReceipts              MessageReceipt[]
  agentSessions                AgentSession[]
  aiRuns                       AIRun[]
  preferredLanguage            String?
  preferredLocale              String?
  preferredCurrency            String?                    @db.Char(3)
  preferredTimezone            String?
  mvpPhotoConsents             MvpPhotoConsent[]
  mvpPhotos                    MvpPhoto[]
  mvpAnalyses                  MvpPhotoAnalysis[]
  mvpPrivacyEvents             MvpPrivacyEvent[]
}

model Business {
  id                               String                            @id @default(cuid())
  mvpCatalogVectors                MvpCatalogVector[]
  mvpVerificationRequests          MvpVerificationRequest[]
  name                             String
  slug                             String                            @unique
  description                      String?
  phone                            String?
  email                            String?
  website                          String?
  logoUrl                          String?
  coverImageUrl                    String?
  status                           BusinessStatus                    @default(ACTIVE)
  isPublic                         Boolean                           @default(false)
  isVerified                       Boolean                           @default(false)
  timezone                         String                            @default("Europe/Istanbul")
  currency                         String                            @default("TRY") @db.Char(3)
  country                          String                            @default("TR") @db.Char(2)
  city                             String?
  district                         String?
  address                          String?
  latitude                         Decimal?                          @db.Decimal(9, 6)
  longitude                        Decimal?                          @db.Decimal(9, 6)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  agentSessions                    AgentSession[]
  aiRuns                           AIRun[]
  aiSafetyIncidents                AISafetyIncident[]
  aiKillSwitches                   AIKillSwitch[]
  predictions                      Prediction[]
  predictionStrategies             PredictionStrategyVersion[]
  predictionEvents                 PredictionEvent[]
  beautyDNAProfiles                BeautyDNAProfile[]
  beautyDNAEvents                  BeautyDNAEvent[]
  professionalIntelligenceProfiles ProfessionalIntelligenceProfile[]
  intelligenceProfile              BusinessIntelligenceProfile?
  metricDefinitions                BusinessMetricDefinition[]
  metricObservations               BusinessMetricObservation[]
  metricSnapshots                  BusinessMetricSnapshot[]
  intelligenceInsights             BusinessInsight[]
  intelligenceOpportunities        BusinessOpportunity[]
  intelligenceRisks                BusinessRiskSignal[]
  intelligenceBenchmarks           BusinessBenchmark[]
  growthRecommendations            BusinessGrowthRecommendation[]
  growthExperiments                BusinessGrowthExperiment[]
  intelligenceVersions             BusinessIntelligenceVersion[]
  marketplaceLiquidityProfile      MarketplaceLiquidityProfile?
  marketplaceDemandSignals         MarketplaceDemandSignal[]
  marketplaceSupplySignals         MarketplaceSupplySignal[]
  marketplaceCapacityObservations  MarketplaceCapacityObservation[]
  marketplaceLiquiditySnapshots    MarketplaceLiquiditySnapshot[]
  marketplaceSupplyGaps            MarketplaceSupplyGap[]
  marketplaceSupplyOpportunities   MarketplaceSupplyOpportunity[]
  marketplaceNetworkSignals        MarketplaceNetworkSignal[]
  marketplaceLiquidityVersions     MarketplaceLiquidityVersion[]
  apiApplications                  APIApplication[]
  webhookEndpoints                 WebhookEndpoint[]
  apiUsageRecords                  APIUsageRecord[]
  apiRateLimitBuckets              APIRateLimitBucket[]
  memberships                      BusinessMember[]
  locations                        Location[]
  staff                            Staff[]
  services                         Service[]
  serviceCategories                ServiceCategory[]
  staffServices                    StaffService[]
  appointments                     Appointment[]
  customers                        BusinessCustomer[]
  customerNotes                    CustomerNote[]
  customerTags                     CustomerTag[]
  customerSegments                 CustomerSegment[]
  automations                      Automation[]
  automationEvents                 AutomationEvent[]
  automationExecutions             AutomationExecution[]
  notificationTemplates            NotificationTemplate[]
  notifications                    Notification[]
  notificationDeliveries           NotificationDelivery[]
  notificationPreferences          NotificationPreference[]
  notificationProviderConfigs      NotificationProviderConfig[]
  pushDevices                      PushDevice[]
  conversations                    Conversation[]
  messages                         Message[]
  communicationOutbox              CommunicationOutbox[]
  reviews                          Review[]
  idempotencyRecords               IdempotencyRecord[]
  cacheEntries                     InfrastructureCacheEntry[]
  backgroundJobs                   BackgroundJob[]
  auditLogs                        AuditLog[]
  securityEvents                   SecurityEvent[]
  branches                         Branch[]
  settings                         BusinessSettings?
  workingHours                     WorkingHour[]
  categoryConfigurations           TenantCategoryConfiguration[]
  globalizationProfile             TenantGlobalizationProfile?
  monetizationSubscriptions        MonetizationSubscription[]
  monetizationUsage                MonetizationUsageRecord[]
  financialLedger                  FinancialLedgerEntry[]
  financialRefunds                 RefundRecord[]
  settlements                      FinancialSettlement[]
  payouts                          FinancialPayout[]
  billingAccount                   BillingAccount?
  financialCredits                 FinancialCreditGrant[]
  financialMetricSnapshots         FinancialMetricSnapshot[]
  paymentWebhookEvents             PaymentWebhookEvent[]
  referralPrograms                 ReferralProgram[]
  referralCodes                    ReferralCode[]
  referrals                        Referral[]
  growthRewards                    GrowthReward[]
  growthRiskAssessments            GrowthRiskAssessment[]
  growthCampaigns                  GrowthCampaign[]
  growthChallenges                 GrowthChallenge[]
  challengeProgress                ChallengeProgress[]
  attributionTouches               AttributionTouch[]
  referralExperiments              GrowthExperiment[]
  experimentAssignments            ExperimentAssignment[]
  growthEvents                     GrowthEvent[]
  growthMetricSnapshots            GrowthMetricSnapshot[]
  growthInvites                    GrowthInvite[]
  growthStreaks                    GrowthStreak[]
  lifecycleStates                  CustomerLifecycleState[]
  audienceDefinitions              AudienceDefinition[]
  audienceMemberships              AudienceMembership[]
  governancePolicies               GovernancePolicy[]
  policyEvaluations                PolicyEvaluation[]
  humanOverrides                   HumanOverride[]
  governanceDisputes               GovernanceDispute[]
  consentRecords                   ConsentRecord[]
  privacyRequests                  PrivacyRequest[]
  retentionPolicies                RetentionPolicy[]
  enforcementActions               EnforcementAction[]
  governanceEvents                 GovernanceEvent[]
  resources                        PlatformResource[]
  resourceTypes                    PlatformResourceType[]

  @@index([isPublic, status, city, district])
  @@index([isPublic, isVerified])
  @@index([isPublic, status, name])
  @@index([isPublic, status, latitude, longitude])
}

enum BackgroundJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  RETRYING
  DEAD_LETTER
}

enum AuditResult {
  SUCCEEDED
  DENIED
  FAILED
}

enum SecuritySeverity {
  INFO
  WARNING
  CRITICAL
}

model AuditLog {
  id            String      @id @default(cuid())
  businessId    String
  actorId       String?
  actorType     String
  action        String
  resourceType  String
  resourceId    String?
  requestId     String?
  correlationId String?
  metadata      Json?
  result        AuditResult
  createdAt     DateTime    @default(now())
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, resourceType, resourceId, createdAt])
  @@index([businessId, actorId, createdAt])
}

model SecurityEvent {
  id         String           @id @default(cuid())
  businessId String?
  actorId    String?
  actorType  String?
  type       String
  severity   SecuritySeverity
  requestId  String?
  route      String?
  metadata   Json?
  createdAt  DateTime         @default(now())
  business   Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([type, severity, createdAt])
}

model AbuseLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  businessId  String
  actorId     String
  operation   String
  keyHash     String
  requestHash String
  statusCode  Int?
  response    Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, actorId, operation, keyHash])
  @@index([expiresAt])
}

model InfrastructureCacheEntry {
  id         String   @id @default(cuid())
  businessId String
  namespace  String
  keyHash    String
  value      Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, namespace, keyHash])
  @@index([businessId, namespace, expiresAt])
  @@index([expiresAt])
}

model BackgroundJob {
  id             String              @id @default(cuid())
  businessId     String
  type           String
  idempotencyKey String
  correlationId  String
  actorId        String?
  payload        Json
  status         BackgroundJobStatus @default(PENDING)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  availableAt    DateTime            @default(now())
  lockedAt       DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  lastError      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, type, idempotencyKey])
  @@index([status, availableAt])
  @@index([businessId, status, createdAt])
  @@index([correlationId])
}

model BusinessMember {
  id            String             @id @default(cuid())
  userId        String
  businessId    String
  role          BusinessRole
  createdAt     DateTime           @default(now())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffServices StaffService[]
  appointments  Appointment[]
  workingHours  StaffWorkingHour[]
  timeOff       StaffTimeOff[]

  @@unique([userId, businessId])
  @@unique([businessId, id])
  @@index([businessId, role])
}

model Branch {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  slug         String
  phone        String?
  email        String?
  country      String        @default("TR") @db.Char(2)
  city         String
  district     String?
  address      String
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  timezone     String        @default("Europe/Istanbul")
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workingHours WorkingHour[]

  @@unique([businessId, slug])
  @@unique([businessId, id])
  @@index([businessId, isActive])
}

model BusinessSettings {
  businessId                 String   @id
  defaultCurrency            String   @default("TRY") @db.Char(3)
  timezone                   String   @default("Europe/Istanbul")
  bookingEnabled             Boolean  @default(true)
  onlinePaymentEnabled       Boolean  @default(false)
  cancellationEnabled        Boolean  @default(true)
  cancellationWindowMinutes  Int      @default(120)
  appointmentIntervalMinutes Int      @default(15)
  customerCanChooseStaff     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  business                   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WorkingHour {
  id         String    @id @default(cuid())
  businessId String
  branchId   String?
  dayOfWeek  DayOfWeek
  isOpen     Boolean   @default(true)
  openTime   String?
  closeTime  String?
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch     Branch?   @relation(fields: [businessId, branchId], references: [businessId, id], onDelete: Cascade)

  @@unique([businessId, branchId, dayOfWeek])
  @@index([businessId, branchId])
}

model RefreshSession {
  id        String    @id
  userId    String
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id                String                   @id @default(cuid())
  userId            String                   @unique
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  businessProfiles  BusinessCustomer[]
  reviews           Review[]
  preferredLanguage String?
  preferredLocale   String?
  preferredCurrency String?                  @db.Char(3)
  preferredTimezone String?
  measurementSystem GlobalMeasurementSystem?
}

model BusinessCustomer {
  id                      String                      @id @default(cuid())
  businessId              String
  userCustomerId          String?
  firstName               String
  lastName                String
  phone                   String?
  email                   String?
  birthDate               DateTime?                   @db.Date
  gender                  CustomerGender?
  notes                   String?
  source                  String?
  archivedAt              DateTime?
  mergedIntoId            String?
  preferredStaffId        String?
  marketingConsent        Boolean                     @default(false)
  smsConsent              Boolean                     @default(false)
  emailConsent            Boolean                     @default(false)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt
  business                Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userCustomer            Customer?                   @relation(fields: [userCustomerId], references: [id], onDelete: SetNull)
  appointments            Appointment[]
  customerNotes           CustomerNote[]
  tags                    CustomerTagAssignment[]
  segmentMemberships      CustomerSegmentMembership[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  predictions             Prediction[]
  beautyDNAProfile        BeautyDNAProfile?
  preferredStaff          Staff?                      @relation("PreferredStaff", fields: [businessId, preferredStaffId], references: [businessId, id], onDelete: Restrict)
  mergedInto              BusinessCustomer?           @relation("CustomerMerge", fields: [businessId, mergedIntoId], references: [businessId, id], onDelete: Restrict)
  mergedCustomers         BusinessCustomer[]          @relation("CustomerMerge")

  @@unique([businessId, id])
  @@unique([businessId, phone])
  @@unique([businessId, email])
  @@index([businessId, lastName, firstName])
  @@index([businessId, createdAt])
  @@index([userCustomerId])
  @@index([businessId, preferredStaffId])
}

model CustomerTag {
  id         String                  @id @default(cuid())
  businessId String
  name       String
  slug       String
  color      String?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  business   Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers  CustomerTagAssignment[]

  @@unique([businessId, id])
  @@unique([businessId, slug])
  @@index([businessId, name])
}

model CustomerTagAssignment {
  businessId String
  customerId String
  tagId      String
  createdAt  DateTime         @default(now())
  customer   BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)
  tag        CustomerTag      @relation(fields: [businessId, tagId], references: [businessId, id], onDelete: Cascade)

  @@id([customerId, tagId])
  @@index([businessId, tagId, customerId])
}

model CustomerSegment {
  id          String                      @id @default(cuid())
  businessId  String
  name        String
  description String?
  type        CustomerSegmentType
  rules       Json?
  isActive    Boolean                     @default(true)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  business    Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships CustomerSegmentMembership[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, isActive, createdAt])
}

model CustomerSegmentMembership {
  businessId String
  segmentId  String
  customerId String
  createdAt  DateTime         @default(now())
  segment    CustomerSegment  @relation(fields: [businessId, segmentId], references: [businessId, id], onDelete: Cascade)
  customer   BusinessCustomer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Cascade)

  @@id([segmentId, customerId])
  @@index([businessId, customerId, segmentId])
}

model Automation {
  id            String                @id @default(cuid())
  businessId    String
  createdById   String
  name          String
  description   String?
  status        AutomationStatus      @default(DRAFT)
  triggerType   String
  triggerConfig Json
  conditions    Json
  actions       Json
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  archivedAt    DateTime?
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy     User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  executions    AutomationExecution[]

  @@unique([businessId, id])
  @@unique([businessId, name])
  @@index([businessId, status])
  @@index([businessId, triggerType])
}

model AutomationEvent {
  id            String                @id
  businessId    String
  eventType     String
  occurredAt    DateTime
  customerId    String?
  appointmentId String?
  metadata      Json
  correlationId String
  causationId   String?
  depth         Int                   @default(0)
  createdAt     DateTime              @default(now())
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  executions    AutomationExecution[]

  @@unique([businessId, id])
  @@index([businessId, eventType, occurredAt])
}

model AutomationExecution {
  id            String                    @id @default(cuid())
  businessId    String
  automationId  String
  eventId       String?
  customerId    String?
  appointmentId String?
  status        AutomationExecutionStatus @default(PENDING)
  startedAt     DateTime                  @default(now())
  completedAt   DateTime?
  failureReason String?
  executionKey  String
  result        Json?
  notifications Notification[]
  business      Business                  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  automation    Automation                @relation(fields: [businessId, automationId], references: [businessId, id], onDelete: Restrict)
  event         AutomationEvent?          @relation(fields: [businessId, eventId], references: [businessId, id], onDelete: Restrict)

  @@unique([businessId, executionKey])
  @@index([automationId, startedAt])
  @@index([businessId, customerId, startedAt])
}

model NotificationTemplate {
  id            String                     @id @default(cuid())
  businessId    String
  name          String
  channel       NotificationChannel
  subject       String?
  body          String
  variables     Json
  locale        String                     @default("tr-TR")
  status        NotificationTemplateStatus @default(DRAFT)
  createdById   String
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  archivedAt    DateTime?
  business      Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy     User                       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  notifications Notification[]

  @@unique([businessId, id])
  @@unique([businessId, name, locale, channel])
  @@index([businessId, status, channel])
}

model Notification {
  id                    String                 @id @default(cuid())
  businessId            String
  customerId            String?
  userId                String?
  appointmentId         String?
  automationExecutionId String?
  templateId            String?
  channel               NotificationChannel
  kind                  NotificationKind       @default(TRANSACTIONAL)
  category              NotificationCategory   @default(SYSTEM)
  recipient             String
  subject               String?
  body                  String
  status                NotificationStatus     @default(PENDING)
  scheduledAt           DateTime?
  sentAt                DateTime?
  correlationId         String?
  causationId           String?
  idempotencyKey        String
  metadata              Json
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  archivedAt            DateTime?
  readAt                DateTime?
  business              Business               @relation(fields: [businessId], references: [id], onDelete: Restrict)
  customer              BusinessCustomer?      @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  user                  User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
