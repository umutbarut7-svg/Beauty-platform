  model             String?
  attempts          Int      @default(0)
  matchingStatus    String?
  matchingRequestId String?
  matchingOutput    Json?
  expiresAt         DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  owner             User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photo             MvpPhoto @relation(fields: [ownerId, photoId], references: [ownerId, id], onDelete: Restrict)

  @@index([ownerId, expiresAt])
}

model MvpPrivacyEvent {
  id            String   @id @default(uuid())
  ownerId       String
  resourceId    String
  action        String
  correlationId String
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([createdAt])
  @@index([expiresAt])
}

model MvpCatalogVector {
  serviceId         String
  businessId        String
  model             String
  embedding         Unsupported("vector(1536)")
  sourceUpdatedAt   DateTime
  businessUpdatedAt DateTime
  indexedAt         DateTime                    @default(now())
  service           Service                     @relation(fields: [businessId, serviceId], references: [businessId, id], onDelete: Cascade)
  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([serviceId, model])
  @@index([businessId])
}

model MvpVerificationRequest {
  id                String    @id @default(uuid())
  businessId        String
  requesterId       String
  policyVersion     String    @db.VarChar(100)
  answers           Json
  status            String    @default("SUBMITTED")
  reviewerId        String?
  reviewedAt        DateTime?
  reviewNote        String?   @db.VarChar(1000)
  createdAt         DateTime  @default(now())
  evidenceExpiresAt DateTime
  business          Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([status, createdAt])
  @@index([evidenceExpiresAt])
}
