{
  "expo": {
    "name": "EPIFIZ",
    "slug": "beauty-platform",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": { "bundler": "metro" },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Seçtiğiniz fotoğrafı izin verdiğiniz görsel danışmanlık için kullanın.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
