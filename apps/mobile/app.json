{
  "expo": {
    "name": "ORZELL",
    "slug": "beauty-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Seçtiğiniz fotoğrafı izin verdiğiniz görsel danışmanlık için kullanın.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "android": {
      "package": "dev.epifiz.preview"
    },
    "ios": {
      "bundleIdentifier": "com.orzell.app",
      "appleTeamId": "CDL78S6U9A",
      "buildNumber": "1"
    }
  }
}
