{$PREVIEW_HOST} {
  encode gzip
  request_body {
    max_size 6MB
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(self), microphone=()"
  }
  handle_path /api/* {
    reverse_proxy api:3001
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

{$ADMIN_HOST} {
  encode gzip
  handle_path /api/* {
    reverse_proxy api:3001
  }
  handle {
    reverse_proxy admin:3000
  }
}
