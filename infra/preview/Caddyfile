{$PREVIEW_HOST} {
  encode gzip
  request_body {
    max_size 6MB
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(self), microphone=()"
  }
  @appleServiceLink {
    host preview.13-51-112-228.sslip.io
    path /.well-known/apple-app-site-association
  }
  handle @appleServiceLink {
    header Content-Type application/json
    header Cache-Control "no-store"
    respond `{"applinks":{"details":[{"appIDs":["CDL78S6U9A.com.orzell.app"],"components":[{"/":"/discover/service"}]}]}}` 200
  }
  @androidServiceLink {
    host preview.13-51-112-228.sslip.io
    path /.well-known/assetlinks.json
  }
  handle @androidServiceLink {
    header Content-Type application/json
    header Cache-Control "no-store"
    respond "[]" 200
  }
  @publicServicePages {
    host preview.13-51-112-228.sslip.io
    path /discover/service /book/service /_next/static/* /orzell-original-reference.jpg
  }
  handle @publicServicePages {
    reverse_proxy admin:3000
  }
  handle_path /api/* {
    reverse_proxy api:3001
  }
  handle {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
}

{$ADMIN_HOST} {
  encode gzip
  handle_path /api/* {
    reverse_proxy api:3001
  }
  handle {
    reverse_proxy admin:3000
  }
}

links.orzell.app {
  encode gzip
  header X-Content-Type-Options nosniff
  @association {
    method GET HEAD
    path /.well-known/apple-app-site-association
  }
  handle @association {
    header Content-Type application/json
    respond `{"applinks":{"details":[{"appIDs":["CDL78S6U9A.com.orzell.app"],"components":[{"/":"/discover/service"}]}]}}` 200
  }
  @service {
    method GET HEAD
    path /discover/service /book/service /_next/static/* /orzell-original-reference.jpg
  }
  handle @service {
    reverse_proxy admin:3000
  }
  handle {
    respond 404
  }
}
